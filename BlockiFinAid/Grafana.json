{
  "id": null,
  "uid": "blockifinaid-observability",
  "title": "BlockiFinAid - Live Data",
  "tags": ["blockifinaid", "live"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Total Number of Students Funded per Funder",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "blockifinaid_students_funded_total{data_source=\"live\"}",
          "legendFormat": "{{funder}}",
          "refId": "A",
          "instant": true,
          "interval": "1s"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "namePlacement": "left",
        "valuePlacement": "right",
        "showUnfilled": true,
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Payments Created per Funder (Last 24 Hours)",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "blockifinaid_payments_created_last_24_hours{data_source=\"live\"}",
          "legendFormat": "{{funder}}",
          "refId": "A",
          "instant": true,
          "interval": "1s"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "namePlacement": "left",
        "valuePlacement": "right",
        "showUnfilled": true,
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Persisted Payments by Status",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "sum by (status) (blockifinaid_payments_persisted_by_status_total{data_source=\"live\"})",
          "legendFormat": "{{status}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "namePlacement": "left",
        "valuePlacement": "right",
        "showUnfilled": true,
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Failed Payments by Reason (Last 24 Hours)",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "sum by (reason) (blockifinaid_payment_failures_last_24_hours{data_source=\"live\"})",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "namePlacement": "left",
        "valuePlacement": "right",
        "showUnfilled": true,
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API and Dependency Health",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 12},
      "targets": [
        {"expr": "blockifinaid_api_up", "legendFormat": "API", "refId": "A", "interval": "1s"},
        {"expr": "blockifinaid_dependency_up", "legendFormat": "{{dependency}}", "refId": "B", "interval": "1s"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Endpoint Latency (p95, ms)",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 19},
      "targets": [
        {
          "expr": "blockifinaid_http_request_duration_ms_p95",
          "legendFormat": "{{method}} {{route}} ({{status}})",
          "refId": "A",
          "interval": "1s"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Background Operation Latency (p95, ms)",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 19},
      "targets": [
        {
          "expr": "blockifinaid_operation_duration_ms_p95",
          "legendFormat": "{{pipeline}} / {{model}} / {{step}}",
          "refId": "A",
          "interval": "1s"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Persisted Payments",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 27},
      "targets": [
        {
          "expr": "sum(blockifinaid_payments_persisted_total{data_source=\"live\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Persisted Payments by Funder",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 6, "w": 18, "x": 6, "y": 27},
      "targets": [
        {
          "expr": "blockifinaid_payments_persisted_total{data_source=\"live\"}",
          "legendFormat": "{{funder}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "namePlacement": "left",
        "valuePlacement": "right",
        "showUnfilled": true,
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    }
  ]
}
