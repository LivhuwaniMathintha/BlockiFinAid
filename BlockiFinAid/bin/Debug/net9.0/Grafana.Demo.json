{
  "id": null,
  "uid": "blockifinaid-demo",
  "title": "BlockiFinAid Observability",
  "tags": ["blockifinaid", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Students Funded per Funder (Latest Demo Run)",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "blockifinaid_demo_run_students_funded",
          "legendFormat": "{{funder}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "namePlacement": "left",
        "valuePlacement": "right",
        "showUnfilled": true,
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Payments Created per Funder (Latest Demo Run)",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "blockifinaid_demo_run_payments_created",
          "legendFormat": "{{funder}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "namePlacement": "left",
        "valuePlacement": "right",
        "showUnfilled": true,
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Persisted Payment Statuses",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "sum by (status) (blockifinaid_payments_persisted_by_status_total)",
          "legendFormat": "{{status}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "legend": {"showLegend": true, "displayMode": "list", "placement": "right"},
        "pieType": "pie",
        "reduceOptions": {"values": true, "calcs": ["lastNotNull"], "fields": ""},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Failed Payments by Reason (Last 24 Hours)",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "sum by (reason) (blockifinaid_payment_failures_last_24_hours)",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "namePlacement": "left",
        "valuePlacement": "right",
        "showUnfilled": true,
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "tooltip": {"mode": "single", "sort": "desc"}
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Demo Runs and Current Payment Status",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 15},
      "targets": [
        {
          "expr": "blockifinaid_demo_payments_total",
          "legendFormat": "{{demo_run_id}} / {{funder}} / {{status}} [{{data_source}}]",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API and Dependency Health",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 23},
      "targets": [
        {"expr": "blockifinaid_api_up", "legendFormat": "API", "refId": "A", "interval": "1s"},
        {"expr": "blockifinaid_dependency_up", "legendFormat": "{{dependency}}", "refId": "B", "interval": "1s"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP Endpoint Latency (p95, ms)",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30},
      "targets": [
        {
          "expr": "blockifinaid_http_request_duration_ms_p95",
          "legendFormat": "{{method}} {{route}} ({{status}})",
          "refId": "A",
          "interval": "1s"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Background Operation Latency (p95, ms)",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30},
      "targets": [
        {
          "expr": "blockifinaid_operation_duration_ms_p95",
          "legendFormat": "{{pipeline}} / {{model}} / {{step}}",
          "refId": "A",
          "interval": "1s"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Payments Created (Last 24 Hours, Total)",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 38},
      "targets": [
        {
          "expr": "sum(blockifinaid_payments_created_last_24_hours)",
          "refId": "A",
          "instant": true,
          "interval": "1s"
        }
      ],
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Payments Currently Initiated",
      "datasource": {"type": "prometheus", "uid": "blockifinaid-prometheus"},
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 38},
      "targets": [
        {
          "expr": "sum(blockifinaid_payment_status_last_24_hours{status=\"Initiated\"})",
          "refId": "A",
          "instant": true,
          "interval": "1s"
        }
      ],
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    }
  ]
}
