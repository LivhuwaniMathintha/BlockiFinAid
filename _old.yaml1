services:
  mongodb:
    image: mongo:latest
    container_name: victor-mongo-db
    ports:
      - "27017:27017"
    environment:
#      MONGO_INITDB_ROOT_USERNAME: victor
#      MONGO_INITDB_ROOT_PASSWORD: mongodb@123
      MONGO_INITDB_DATABASE: General
    volumes:
      - mongo-data:/data/db
    command: mongod --replSet rs0 --bind_ip_all
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    networks:
      - app-network
  # Service to initialize the MongoDB replica set
  mongo-init:
    image: mongo:latest
    container_name: victor-mongo-init
    depends_on:
      mongodb:
        condition: service_healthy # This now waits for the enhanced healthcheck
    # Removed keyFile volume mount
    
    command: >
      bash -c "sleep 10 && mongosh 'mongodb:27017' --eval \" # Using the provided connection URL
        var config = {
          _id: 'rs0',
          members: [
            { _id: 0, host: 'mongodb:27017' }
          ]
        };
        try {
          rs.initiate(config);
          print('Replica set initiated successfully.');
        } catch (e) {
          if (e.code === 23) { # Error code 23 means 'already initialized'
            print('Replica set already initiated.');
          } else {
            throw e;
          }
        }
      \""
    restart: "no"
    networks:
      - app-network
  mongo-express:
    image: mongo-express:latest
    container_name: victor-mongo-express
    ports:
      - "8081:8081"
    environment:
      ME_CONFIG_MONGODB_URL: mongodb
      ME_CONFIG_MONGODB_ENABLE_ADMIN: 'false'
      ME_CONFIG_BASICAUTH_USERNAME: ""
      ME_CONFIG_BASICAUTH_PASSWORD: ""
    depends_on:
      mongodb:
        condition: service_healthy
    restart: unless-stopped
    networks:
      - app-network
    
  rabbitmq: # NEW RABBITMQ SERVICE
    image: rabbitmq:4-management # Uses the 4.x management image as specified
    container_name: victor_queues
    ports:
      - "5672:5672" # Standard AMQP port for client connections
      - "15672:15672" # Management UI port
    # You can add environment variables for user/password if needed, e.g.:
    # environment:
    #   RABBITMQ_DEFAULT_USER: your_rabbitmq_user
    #   RABBITMQ_DEFAULT_PASS: your_rabbitmq_password
    
    restart: unless-stopped # Ensures RabbitMQ restarts with Docker

networks:
  app-network:
    driver: bridge

volumes:
  mongo-data: